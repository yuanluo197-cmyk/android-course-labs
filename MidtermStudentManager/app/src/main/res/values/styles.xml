<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brown</item>
        <item name="android:textColorPrimary">@color/brown</item>
        <item name="android:textColorSecondary">@color/brown</item>
        <item name="android:textColorHint">@color/brown</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:buttonStyle">@style/BrownButton</item>
        <item name="android:editTextStyle">@style/BrownEditText</item>
    </style>
    <style name="BrownButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:textColor">@color/brown</item>
        <item name="android:backgroundTint">@color/button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="BrownEditText" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:textColor">@color/brown</item>
        <item name="android:textColorHint">@color/brown</item>
        <item name="android:backgroundTint">@color/brown</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
