<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/score" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="6dp" android:textSize="18sp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/ready" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cards"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:id="@+id/rules" android:text="@string/rules" android:textSize="13sp" />
    <Button android:id="@+id/restart" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/restart" />
</LinearLayout>
