<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView style="@style/Heading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/app_name" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="8dp">
        <Button android:id="@+id/profile_tab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/profile_title" />
        <Button android:id="@+id/pair_tab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/pair_title" />
        <Button android:id="@+id/triple_tab" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/triple_title" />
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
